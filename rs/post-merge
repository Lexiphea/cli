#!/bin/sh
# Git post-merge hook for the dotfiles repo, linked into its .git/hooks by setup-dotfiles.sh.
# ~/.local/bin/caelestia runs the build output directly, so rebuild it whenever a pull moves this
# submodule. Update the submodule first: a plain `git pull` leaves it on the old commit.
git diff --quiet ORIG_HEAD HEAD -- caelestia-cli && exit 0
git submodule update --init caelestia-cli || exit 0
echo "caelestia-cli changed, rebuilding the caelestia binary..."
# From rs/, so Cargo reads rs/.cargo/config.toml
(cd caelestia-cli/rs && cargo build --release --quiet) ||
    echo "caelestia: build failed, the previous binary is still in place" >&2
